# Where the usage database lives (default: ~/.local/share/giuggiai-meter/usage.db)
GIUGGIAI_METER_DB=
# Price list in JSON (default: ~/.config/giuggiai-meter/prices.json). Start from examples/prices.example.json
GIUGGIAI_METER_PRICES=
# Optional label for the machine or service that logs (default: hostname)
GIUGGIAI_METER_SOURCE=
# Optional remote ingest (containers, other hosts): URL of POST /ingest and its shared token
GIUGGIAI_METER_URL=
GIUGGIAI_METER_TOKEN=
