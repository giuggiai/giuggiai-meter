    {"id": "support-bot-daily", "match": {"project": "support-bot"}, "limit": 3, "period": "day", "on_exceed": "block"},
    {"id": "prepaid-credit", "match": {"provider": "Anthropic"}, "limit": 190, "period": "total", "since": "2026-10-01",
     "on_exceed": "block", "fail": "closed"}
  ],
  "plans": [
    {"id": "coding-plan", "monthly_fee": 100, "currency": "USD", "match": {"source": "ide/*"}}
  ]
