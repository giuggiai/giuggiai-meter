{
  "_note": "EXAMPLE budgets file: ids, patterns and amounts are placeholders. Put it at ~/.config/giuggiai-meter/budgets.json or point GIUGGIAI_METER_BUDGETS at it. Amounts are in `currency`; prices are in USD and converted with `fx` (1 USD = fx.USD units of currency).",
  "currency": "EUR",
  "fx": {"USD": 0.92},
  "budgets": [
    {"id": "agents-monthly", "match": {"source": "agents/*"}, "limit": 50, "period": "month",
